# Docker ignore para Mission Control
# ================================

# Git
.git
.gitignore
.gitattributes

# Node modules (se instalan en el contenedor)
**/node_modules
**/dist
**/.turbo

# IDE & OS
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Logs y datos locales (se montan como volúmenes)
logs/
data/
*.log
npm-debug.log*

# Test & coverage
coverage/
*.test.js
*.spec.js
__tests__
__mocks__

# Documentación temporal
tmp/
temp/
.cache/

# Python cache
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv
**/venv

# Archivos de entorno (no incluir en imagen)
.env
.env.local
.env.*.local
.env.vps

#Archivos de Supabase locales
supabase/.env

# Archivos del sistema OpenClaw (no necesarios en el contenedor)
.openclaw/
.agents/
systemd/
clawflows/
clawflows-audit/
config/docker.future.json  # archivo experimental

# Archivos de build del dashboard (se copian desde el builder)
apps/dashboard/node_modules
apps/dashboard/.vite

# Documentation source (no necesaria en producción)
docs/MASTER_PLAN.md
docs/SECURITY_MODEL.md
docs/PRODUCT_REQUIREMENTS.md
docs/AGENTS_OVERVIEW.md
docs/TEMPLATES.md

# Misc
README.md (se copia aparte si se quiere)
TODO.md
CHANGELOG.md
*.md (excepto los necesarios)

# Certificados y claves
*.pem
*.key
*.crt
secrets/
