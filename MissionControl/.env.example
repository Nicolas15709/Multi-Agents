MISSION_CONTROL_DB=./data/sessions.db
MISSION_CONTROL_LOG_LEVEL=info
MISSION_CONTROL_MAX_RETRIES=3
MISSION_CONTROL_CONTEXT_BUDGET_CHARS=280000
MISSION_CONTROL_CONTEXT_RECENT_MESSAGES=18
MISSION_CONTROL_POLL_INTERVAL_MS=5000
MISSION_CONTROL_DEFAULT_GOAL=
MISSION_CONTROL_RUNTIME_DB=./data/runtime.db
MISSION_CONTROL_WEBSOCKET=true
MISSION_CONTROL_WEBSOCKET_HOST=127.0.0.1
MISSION_CONTROL_WEBSOCKET_PORT=8765
MISSION_CONTROL_API=true
MISSION_CONTROL_API_HOST=127.0.0.1
MISSION_CONTROL_API_PORT=8787
MISSION_CONTROL_API_CORS_ORIGIN=http://localhost:5173
# ── Auth / JWT (REQUIRED for production) ──────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
MISSION_CONTROL_JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret
MISSION_CONTROL_JWT_EXPIRY_HOURS=24
# Dashboard login credentials
MISSION_CONTROL_DASHBOARD_USERNAME=admin
MISSION_CONTROL_DASHBOARD_PASSWORD=CHANGE_ME_use_a_strong_password
# Legacy static token (leave empty when JWT is configured above)
MISSION_CONTROL_API_AUTH_TOKEN=
MISSION_CONTROL_HIRE_APPROVALS=false
MISSION_CONTROL_AUTO_PROPOSE_HIRES=true
MISSION_CONTROL_SPECIALIST_TEMPLATES_ROOT=../references/agency-agents
MISSION_CONTROL_MAX_AUTONOMOUS_STEPS=18
MISSION_CONTROL_MAX_ESTIMATED_TOKENS=16000
MISSION_CONTROL_MAX_RUNTIME_TICKS=64
MISSION_CONTROL_MAX_DYNAMIC_HIRES=3
MISSION_CONTROL_ACTION_BUDGETS_JSON={"outreach":2,"publish":1,"legal_release":1,"financial_commitment":1}
MISSION_CONTROL_TICK_INTERVAL_SECONDS=5

# Memory System - Vector Store (Supabase pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Memory System - Embeddings (OpenAI or Groq)
EMBEDDING_PROVIDER=openai  # openai | groq
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CACHE=true

# Memory TTL Policies (days)
MEMORY_TTL_MEMORIES_DAYS=180
MEMORY_TTL_SESSIONS_DAYS=7
MEMORY_TTL_SNAPSHOTS_DAYS=90
MEMORY_DIFFS_TO_KEEP=100
MEMORY_CLEANUP_INTERVAL_HOURS=24
MEMORY_AUTO_CHECKPOINT=true
MEMORY_CHECKPOINT_INTERVAL_MINUTES=30
MEMORY_ENABLE_SYNC_QUEUE=false
MEMORY_COMPRESSION=true

# Search limits
MEMORY_MAX_SEARCH_RESULTS=50
MEMORY_SIMILARITY_THRESHOLD=0.6
