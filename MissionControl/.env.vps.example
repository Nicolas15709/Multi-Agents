# Mission Control - Variables de entorno para VPS
# Copiar este archivo a .env.vps y configurar valores reales
# Nota: Mission Control usa el runtime de Python

# ============================================
# Base de datos (SQLite local)
# ============================================
MISSION_CONTROL_RUNTIME_DB=/app/data/runtime.db
MISSION_CONTROL_ENV=production
MISSION_CONTROL_LOG_LEVEL=info
MISSION_CONTROL_WEBSOCKET=true
MISSION_CONTROL_WEBSOCKET_HOST=0.0.0.0
MISSION_CONTROL_WEBSOCKET_PORT=8765
MISSION_CONTROL_TICK_INTERVAL_SECONDS=5
MISSION_CONTROL_TELEGRAM_NOTIFICATIONS=true
MISSION_CONTROL_TELEGRAM_PROGRESS_MODE=phase_updates

# ============================================
# LLM API (OpenRouter) - REQUIRED
# ============================================
# Sin esto, los agentes no podrán pensar ni actuar
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openrouter/google/gemini-2.0-flash-001

# ============================================
# Supabase (Backend de producto) - OPCIONAL
# ============================================
# Si no se configuran, Mission Control funcionará en modo standalone
# con SQLite local y no tendrá sync con backend web
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Telegram Notifications - OPCIONAL
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ============================================
# Email (SMTP) - OPCIONAL
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# Integraciones externas - OPCIONAL
# ============================================
# GitHub
GITHUB_TOKEN=your-github-token

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ============================================
# Monitoring - OPCIONAL
# ============================================
# Sentry
SENTRY_DSN=your-sentry-dsn
