# Virtual Agency - Variables de entorno para VPS
# Copiar este archivo a .env.vps y configurar valores reales
# Nota: Virtual Agency usa el runtime de Python

# ============================================
# Base de datos (SQLite local)
# ============================================
MISSION_CONTROL_RUNTIME_DB=/app/data/runtime.db
MISSION_CONTROL_ENV=production
MISSION_CONTROL_LOG_LEVEL=info
MISSION_CONTROL_WEBSOCKET=true
MISSION_CONTROL_WEBSOCKET_HOST=127.0.0.1
MISSION_CONTROL_WEBSOCKET_PORT=8765
MISSION_CONTROL_API=true
MISSION_CONTROL_API_HOST=127.0.0.1
MISSION_CONTROL_API_PORT=8787
MISSION_CONTROL_API_CORS_ORIGIN=https://your-vercel-domain.vercel.app
MISSION_CONTROL_API_AUTH_TOKEN=replace-with-long-random-token
MISSION_CONTROL_JWT_SECRET=replace-with-a-long-random-secret
MISSION_CONTROL_JWT_EXPIRY_HOURS=24
MISSION_CONTROL_DASHBOARD_USERNAME=admin
MISSION_CONTROL_DASHBOARD_PASSWORD=replace-with-strong-password
MISSION_CONTROL_HIRE_APPROVALS=true
MISSION_CONTROL_AUTO_PROPOSE_HIRES=true
MISSION_CONTROL_SPECIALIST_TEMPLATES_ROOT=/app/references/agency-agents
MISSION_CONTROL_MAX_AUTONOMOUS_STEPS=18
MISSION_CONTROL_MAX_ESTIMATED_TOKENS=16000
MISSION_CONTROL_MAX_RUNTIME_TICKS=64
MISSION_CONTROL_MAX_DYNAMIC_HIRES=3
MISSION_CONTROL_ACTION_BUDGETS_JSON={"outreach":2,"publish":1,"legal_release":1,"financial_commitment":1}
MISSION_CONTROL_TICK_INTERVAL_SECONDS=5
MISSION_CONTROL_TELEGRAM_NOTIFICATIONS=true
MISSION_CONTROL_TELEGRAM_PROGRESS_MODE=phase_updates

# ============================================
# LLM API (OpenRouter) - REQUIRED
# ============================================
# Sin esto, los agentes no podrÃ¡n pensar ni actuar
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openrouter/google/gemini-2.0-flash-001

# ============================================
# Supabase (Backend de producto) - OPCIONAL
# ============================================
# Si no se configuran, Virtual Agency funcionarÃ¡ en modo standalone
# con SQLite local y no tendrÃ¡ sync con backend web
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Telegram Notifications - OPCIONAL
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ============================================
# Email (SMTP) - OPCIONAL
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# Integraciones externas - OPCIONAL
# ============================================
# GitHub
GITHUB_TOKEN=your-github-token

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ============================================
# Monitoring - OPCIONAL
# ============================================
# Sentry
SENTRY_DSN=your-sentry-dsn

