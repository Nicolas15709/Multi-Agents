# Virtual Agency - Variables de entorno para VPS (produccion)
# ============================================================
# Copiar este archivo: cp .env.vps.example .env
# Rellenar TODOS los valores antes de levantar Docker.
# NUNCA commitear el archivo .env real con secretos.

# ============================================================
# RUNTIME / NETWORK - diferencias clave vs dev
# ============================================================
# En VPS los servidores deben escuchar en 0.0.0.0 para que
# Docker (o systemd) los exponga correctamente al exterior.
MISSION_CONTROL_ENV=production
MISSION_CONTROL_API=true
MISSION_CONTROL_API_HOST=0.0.0.0          # dev usa 127.0.0.1
MISSION_CONTROL_API_PORT=8787
MISSION_CONTROL_WEBSOCKET=true
MISSION_CONTROL_WEBSOCKET_HOST=0.0.0.0    # dev usa 127.0.0.1
MISSION_CONTROL_WEBSOCKET_PORT=8765
MISSION_CONTROL_LOG_LEVEL=info

# CORS: dominio exacto donde vive el frontend (Vercel o Cloudflare Pages)
# Ejemplo: https://mi-agency.vercel.app  o  https://app.mi-dominio.com
MISSION_CONTROL_API_CORS_ORIGIN=https://tu-dominio.vercel.app

# ============================================================
# PERSISTENCE
# ============================================================
# Dentro del contenedor Docker el volumen se monta en /app/data
MISSION_CONTROL_DB=/app/data/sessions.db
MISSION_CONTROL_RUNTIME_DB=/app/data/runtime.db

# ============================================================
# AUTH / JWT - OBLIGATORIO en produccion
# ============================================================
# Genera un secreto fuerte:
#   python -c "import secrets; print(secrets.token_hex(32))"
MISSION_CONTROL_JWT_SECRET=CHANGE_ME_generate_strong_random_secret_here
MISSION_CONTROL_JWT_EXPIRY_HOURS=24

# Credenciales del dashboard (cambia estas antes de hacer deploy)
MISSION_CONTROL_DASHBOARD_USERNAME=admin
MISSION_CONTROL_DASHBOARD_PASSWORD=CHANGE_ME_use_a_strong_password

# Token estatico heredado (dejar vacio si usas JWT)
MISSION_CONTROL_API_AUTH_TOKEN=

# ============================================================
# LLM - OBLIGATORIO para que los agentes funcionen
# ============================================================
# Opcion A - Anthropic directo
# Obtener en: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Opcion B - OpenRouter (acceso a multiples modelos)
# Obtener en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openrouter/google/gemini-2.0-flash-001

# ============================================================
# DATABASE - Supabase (backend de producto, OPCIONAL)
# ============================================================
# Si no se configuran, el runtime usa SQLite local solamente.
# Obtener URL y keys en: https://supabase.com/dashboard/project/<id>/settings/api
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...         # Settings > API > anon public
SUPABASE_SERVICE_ROLE_KEY=eyJ... # Settings > API > service_role (secreto!)

# ============================================================
# MEMORY - Vector Store (pgvector via Supabase, OPCIONAL)
# ============================================================
EMBEDDING_PROVIDER=openai         # openai | groq
OPENAI_API_KEY=sk-CHANGE_ME       # https://platform.openai.com/api-keys
GROQ_API_KEY=gsk_CHANGE_ME        # https://console.groq.com/keys
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CACHE=true

# TTL policies (dias)
MEMORY_TTL_MEMORIES_DAYS=180
MEMORY_TTL_SESSIONS_DAYS=7
MEMORY_TTL_SNAPSHOTS_DAYS=90
MEMORY_DIFFS_TO_KEEP=100
MEMORY_CLEANUP_INTERVAL_HOURS=24
MEMORY_AUTO_CHECKPOINT=true
MEMORY_CHECKPOINT_INTERVAL_MINUTES=30
MEMORY_ENABLE_SYNC_QUEUE=false
MEMORY_COMPRESSION=true
MEMORY_MAX_SEARCH_RESULTS=50
MEMORY_SIMILARITY_THRESHOLD=0.6

# ============================================================
# AGENTES - Comportamiento
# ============================================================
MISSION_CONTROL_MAX_RETRIES=3
MISSION_CONTROL_CONTEXT_BUDGET_CHARS=280000
MISSION_CONTROL_CONTEXT_RECENT_MESSAGES=18
MISSION_CONTROL_POLL_INTERVAL_MS=5000
MISSION_CONTROL_TICK_INTERVAL_SECONDS=5
MISSION_CONTROL_HIRE_APPROVALS=true
MISSION_CONTROL_AUTO_PROPOSE_HIRES=true
MISSION_CONTROL_MAX_AUTONOMOUS_STEPS=18
MISSION_CONTROL_MAX_ESTIMATED_TOKENS=16000
MISSION_CONTROL_MAX_RUNTIME_TICKS=64
MISSION_CONTROL_MAX_DYNAMIC_HIRES=3
MISSION_CONTROL_ACTION_BUDGETS_JSON={"outreach":2,"publish":1,"legal_release":1,"financial_commitment":1}
MISSION_CONTROL_SPECIALIST_TEMPLATES_ROOT=/app/references/agency-agents

# ============================================================
# NOTIFICACIONES - OPCIONAL
# ============================================================
# Telegram: crear bot con @BotFather, obtener chat_id via @userinfobot
MISSION_CONTROL_TELEGRAM_NOTIFICATIONS=true
MISSION_CONTROL_TELEGRAM_PROGRESS_MODE=phase_updates
TELEGRAM_BOT_TOKEN=123456789:CHANGE_ME
TELEGRAM_CHAT_ID=-100CHANGE_ME

# Email SMTP (p.ej. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # https://myaccount.google.com/apppasswords

# ============================================================
# INTEGRACIONES EXTERNAS - OPCIONAL
# ============================================================
# GitHub: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_CHANGE_ME

# AWS: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=AKIACHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1

# ============================================================
# MONITORING - OPCIONAL
# ============================================================
# Sentry: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
