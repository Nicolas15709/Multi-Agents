[Unit]
Description=Mission Control Python Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/.openclaw/workspace/MissionControl/runtime/python
Environment=PYTHONUNBUFFERED=1
Environment=MISSION_CONTROL_ENV=production
Environment=MISSION_CONTROL_WEBSOCKET=true
Environment=MISSION_CONTROL_WEBSOCKET_HOST=0.0.0.0
Environment=MISSION_CONTROL_WEBSOCKET_PORT=8765
Environment=MISSION_CONTROL_TICK_INTERVAL_SECONDS=5
ExecStart=/usr/bin/python3 /home/ubuntu/.openclaw/workspace/MissionControl/runtime/python/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
